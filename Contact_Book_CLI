import json
import os
CONTACT_FILE =  "contacts.json"

# ------ FILE OPERATIONS ------
def load_contacts():
    if os.path.exists(CONTACT_FILE):
        with open(CONTACT_FILE, "r") as f:
            return json.load(f)
    return {}

def save_contacts(contacts):
    with open(CONTACT_FILE, "w") as f:
        json.dump(contacts, f, indent=4)
    print("Contacts saved.")

# ------CONTACT OPERATIONS--------   

def add_contacts(contacts):
    name = input("Name : ").strip().title()
    phone = input("Phone : ").strip()
    email = input("Email : ").strip()
    if name in contacts:
        print(f"'{name}' already exists.")
        return

    contacts[name] = {"phone": phone, "email": email}
    save_contacts(contacts)
    print(f"{name} added.")


def view_contacts(contacts):
    if not contacts:
        print("No contacts yet.")
        return
    for i,(name,d) in enumerate(sorted(contacts.items()),1):
        print(f"\n{i}. {name} | {d['phone']} | {d['email']}")


def search_contact(contacts):
    q = input("Search: ").strip().lower()
    found = {n: d for n, d in contacts.items() if q in n.lower()}
    if not found:
        print("Not found.")
        return
    for n, d in found.items():
        print(f"\n{n} | {d['phone']} | {d['email']}")


def update_contact(contacts):
    name = input("Name to update: ").strip().title()
    if name not in contacts:
        print("Not found.")
        return
    p = input(f"New phone [{contacts[name]['phone']}]: ").strip()
    e = input(f"New email [{contacts[name]['email']}]: ").strip()
    if p: contacts[name]["phone"] = p
    if e: contacts[name]["email"] = e
    save_contacts(contacts)
    print("Updated.")


def delete_contact(contacts):
    name = input("Name to delete: ").strip().title()
    if name not in contacts:
        print("Not found.")
        return
    if input(f"Delete '{name}'? (yes/no): ").strip().lower() == "yes":
        del contacts[name]
        save_contacts(contacts)
        print("Deleted.")


def main():
    contacts = load_contacts()
    print(f"  CONTACT BOOK  ({len(contacts)} contacts)")
    while True:
        print("\n1.Add 2.View 3.Search 4.Update 5.Delete 6.Exit")
        c = input("Choice: ").strip()
        if   c == "1": add_contacts(contacts)
        elif c == "2": view_contacts(contacts)
        elif c == "3": search_contact(contacts)
        elif c == "4": update_contact(contacts)
        elif c == "5": delete_contact(contacts)
        elif c == "6": print("Bye!"); break
        else: print("Enter 1-6.")

main()


